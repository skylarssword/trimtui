#!/usr/bin/env bash
# trimtui — terminal video cutter/converter
# Dependencies: ffmpeg, ffprobe, mpv, fzf, gum
# Optional:     wl-copy / xclip / xsel  (clipboard support)

set -euo pipefail

APP_NAME="trimtui"
APP_VERSION="1.0.0"

# ─── Paths ────────────────────────────────────────────────────────────────────
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
TRIMTUI_CONFIG="$CONFIG_HOME/$APP_NAME"
TRIMTUI_OUTPUT_DIR="${TRIMTUI_OUTPUT_DIR:-$HOME/Videos/$APP_NAME}"
HISTORY_FILE="$TRIMTUI_CONFIG/history"
CONFIG_FILE="$TRIMTUI_CONFIG/config"
PRESETS_DIR="$TRIMTUI_CONFIG/presets"
MPV_LUA_SCRIPT="$TRIMTUI_CONFIG/mpv/marks.lua"
DEFAULT_SEARCH_DIR="${TRIMTUI_SEARCH_DIR:-$HOME/Videos}"
MAX_HISTORY=20

VIDEO_EXTENSIONS=("mp4" "mkv" "mov" "webm" "avi" "m4v" "flv" "wmv")

# ─── Session state ────────────────────────────────────────────────────────────
S_SCALE=""
S_FPS=""
S_CODEC="libx264"
S_CRF="22"
S_PRESET_ENC="medium"
S_AUDIO="copy"
S_CROP=""
S_TARGET_SIZE=""
POST_SPEED=""
POST_MUTE=false
PRESET_MODE=""
TRIM_START=""
TRIM_END=""

# ─── Flag-mode state (set by parse_flags) ─────────────────────────────────────
FLAG_PRESET=""       # preset filename stem, e.g. discord_720p
FLAG_PRESET_TAG=""   # output filename tag, e.g. discord
FLAG_MUTE=false
FLAG_SPEED=""
FLAG_TS_START=""
FLAG_TS_END=""
POSITIONAL=""        # video file or directory, if given

# ─── Run-scoped temp dir ──────────────────────────────────────────────────────
RUN_TMP=""
cleanup() {
    [[ -n "$RUN_TMP" && -d "$RUN_TMP" ]] && rm -rf "$RUN_TMP"
    return 0
}
trap cleanup EXIT INT TERM

# ─── Output helpers — ALL user-facing text goes to stderr ─────────────────────
# Several functions return values via stdout and are called inside $( ).
# If these wrote to stdout their text would be captured as data instead of
# shown, which silently corrupts the result.
die()     { gum style --foreground 9  "✗ $*" >&2; exit 1; }
info()    { gum style --foreground 12 "$*"   >&2; }
success() { gum style --foreground 10 "✓ $*" >&2; }
warn()    { gum style --foreground 11 "⚠ $*" >&2; }

have() { command -v "$1" >/dev/null 2>&1; }

check_deps() {
    local missing=()
    local c
    for c in ffmpeg ffprobe fzf mpv; do
        have "$c" || missing+=("$c")
    done
    if ((${#missing[@]})); then
        printf 'trimtui: missing required dependencies: %s\n' "${missing[*]}" >&2
        printf 'Install them and run trimtui again.\n' >&2
        exit 1
    fi
}

expand_path() {
    local p="$1"
    p="${p/#\~\//$HOME/}"
    [[ "$p" == "~" ]] && p="$HOME"
    printf '%s' "$p"
}

is_video_file() {
    local ext="${1##*.}"; ext="${ext,,}"
    local v
    for v in "${VIDEO_EXTENSIONS[@]}"; do [[ "$ext" == "$v" ]] && return 0; done
    return 1
}

build_find_cmd() {
    local dir="$1" first=true
    local args=("find" "$dir" "-type" "f" "(")
    local ext
    for ext in "${VIDEO_EXTENSIONS[@]}"; do
        $first && args+=("-iname" "*.${ext}") || args+=("-o" "-iname" "*.${ext}")
        first=false
    done
    args+=(")")
    "${args[@]}" 2>/dev/null
}

add_to_history() {
    local file="$1"
    local tmp; tmp=$(grep -vxF "$file" "$HISTORY_FILE" 2>/dev/null || true)
    {
        printf '%s\n' "$file"
        # Must not be the last command in the group: on an empty history a
        # failing test would make the group exit non-zero, and pipefail
        # would then take the whole script down on the very first run.
        if [[ -n "$tmp" ]]; then printf '%s\n' "$tmp"; fi
    } | head -n "$MAX_HISTORY" > "${HISTORY_FILE}.tmp"
    mv -f "${HISTORY_FILE}.tmp" "$HISTORY_FILE"
    return 0
}

get_key() {
    grep -m1 "^${2}=" "$1" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true
}

# ─── Timestamps ───────────────────────────────────────────────────────────────
# Accepts SS, MM:SS or HH:MM:SS (and tolerates 1-2 digit fields).
# Echoes canonical HH:MM:SS, or returns 1 if unparseable.
normalize_ts() {
    local raw="${1//[[:space:]]/}"
    [[ -z "$raw" ]] && return 1

    local h=0 m=0 s=0 total
    local -a parts
    IFS=':' read -r -a parts <<< "$raw"

    case "${#parts[@]}" in
        # A bare number is a plain seconds count, so "90" means 90 seconds.
        1) [[ "${parts[0]}" =~ ^[0-9]{1,7}$ ]] || return 1
           s=$((10#${parts[0]})) ;;
        2) [[ "${parts[0]}" =~ ^[0-9]{1,3}$ && "${parts[1]}" =~ ^[0-9]{1,2}$ ]] || return 1
           m=$((10#${parts[0]})); s=$((10#${parts[1]}))
           (( s > 59 )) && return 1 ;;
        3) [[ "${parts[0]}" =~ ^[0-9]{1,3}$ && "${parts[1]}" =~ ^[0-9]{1,2}$ && "${parts[2]}" =~ ^[0-9]{1,2}$ ]] || return 1
           h=$((10#${parts[0]})); m=$((10#${parts[1]})); s=$((10#${parts[2]}))
           (( m > 59 || s > 59 )) && return 1 ;;
        *) return 1 ;;
    esac

    total=$(( h * 3600 + m * 60 + s ))
    printf '%02d:%02d:%02d' $(( total / 3600 )) $(( total % 3600 / 60 )) $(( total % 60 ))
}

ts_to_secs() {
    local canon; canon=$(normalize_ts "$1") || return 1
    local h m s
    IFS=: read -r h m s <<< "$canon"
    printf '%s' "$(( 10#$h * 3600 + 10#$m * 60 + 10#$s ))"
}

# ─── Config / preset loading ──────────────────────────────────────────────────
apply_settings_from() {
    local file="$1" allow_target="$2"
    local res fps codec crf enc audio target
    res=$(get_key    "$file" "resolution")
    fps=$(get_key    "$file" "fps")
    codec=$(get_key  "$file" "codec")
    crf=$(get_key    "$file" "crf")
    enc=$(get_key    "$file" "enc_preset")
    audio=$(get_key  "$file" "audio")
    target=$(get_key "$file" "target_size")

    [[ "$res" == "original" || -z "$res" ]] && S_SCALE="" || S_SCALE="scale=-2:${res}"
    [[ "$fps" == "original" || -z "$fps" ]] && S_FPS=""   || S_FPS="fps=${fps}"
    [[ -n "$codec" ]] && S_CODEC="$codec"
    [[ -n "$crf"   ]] && S_CRF="$crf"
    [[ -n "$enc"   ]] && S_PRESET_ENC="$enc"
    [[ -n "$audio" ]] && S_AUDIO="$audio"

    if [[ "$allow_target" == "yes" ]]; then
        if [[ -n "$target" ]]; then S_TARGET_SIZE="$target"; else S_TARGET_SIZE=""; fi
    fi
}

load_config() {
    [[ -f "$CONFIG_FILE" ]] || return 0
    apply_settings_from "$CONFIG_FILE" "no"
}

load_preset_file() {
    local file="$1"
    [[ -f "$file" ]] || die "Preset file not found: $file"
    apply_settings_from "$file" "yes"
}

# ─── Video probe ──────────────────────────────────────────────────────────────
PROBE_WIDTH="" PROBE_HEIGHT="" PROBE_FPS_RAW="" PROBE_DURATION_SECS=0 PROBE_HAS_AUDIO=false

probe_video() {
    local file="$1"

    PROBE_WIDTH=$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=width -of csv=p=0 "$file" 2>/dev/null | head -1 | tr -dc '0-9')
    PROBE_HEIGHT=$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=height -of csv=p=0 "$file" 2>/dev/null | head -1 | tr -dc '0-9')
    PROBE_FPS_RAW=$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=r_frame_rate -of csv=p=0 "$file" 2>/dev/null | head -1 | tr -d '[:space:]')

    local dur
    dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$file" 2>/dev/null | head -1)
    dur="${dur%%.*}"; dur="${dur//[^0-9]/}"
    PROBE_DURATION_SECS="${dur:-0}"

    local a
    a=$(ffprobe -v error -select_streams a -show_entries stream=codec_type \
        -of csv=p=0 "$file" 2>/dev/null | head -1)
    [[ -n "$a" ]] && PROBE_HAS_AUDIO=true || PROBE_HAS_AUDIO=false

    [[ -z "$PROBE_WIDTH" || -z "$PROBE_HEIGHT" ]] \
        && die "Could not read video dimensions — is this a valid video file?"
    return 0
}

secs_to_hms() {
    local t="${1:-0}"
    printf '%02d:%02d:%02d' $((t/3600)) $((t%3600/60)) $((t%60))
}

show_video_info() {
    local file="$1"
    local fps_disp
    if [[ "$PROBE_FPS_RAW" == *"/"* ]]; then
        local n="${PROBE_FPS_RAW%/*}" d="${PROBE_FPS_RAW#*/}"
        if [[ "$d" != "0" && -n "$d" ]]; then
            fps_disp=$(awk -v n="$n" -v d="$d" 'BEGIN {printf "%.2f", n/d}')
        else
            fps_disp="?"
        fi
    else
        fps_disp="${PROBE_FPS_RAW:-?}"
    fi

    gum style \
        --border rounded --border-foreground 12 --padding "0 1" --margin "1 0" \
        "$(gum style --bold "File:")       $(basename "$file")
$(gum style --bold "Resolution:")  ${PROBE_WIDTH}x${PROBE_HEIGHT}
$(gum style --bold "FPS:")         $fps_disp
$(gum style --bold "Duration:")    $(secs_to_hms "$PROBE_DURATION_SECS")
$(gum style --bold "Audio:")       $( [[ "$PROBE_HAS_AUDIO" == true ]] && echo "yes" || echo "none" )" >&2
}

# ─── Menu helper ──────────────────────────────────────────────────────────────
# Returns 1 when the user cancels (Esc / Ctrl-C) so callers can decide what to
# do, instead of set -e tearing the whole script down mid-flow.
choose_one() {
    local header="$1"; shift
    local out
    if ! out=$(printf '%s\n' "$@" | gum choose --header "$header" --header.foreground 12); then
        return 1
    fi
    [[ -z "$out" ]] && return 1
    printf '%s' "$out"
}

ask_text() {
    local prompt="$1" placeholder="${2:-}" value="${3:-}"
    local args=(--prompt "$prompt")
    [[ -n "$placeholder" ]] && args+=(--placeholder "$placeholder")
    [[ -n "$value" ]] && args+=(--value "$value")
    local out
    out=$(gum input "${args[@]}") || return 1
    printf '%s' "$out"
}

# ─── Input selection ──────────────────────────────────────────────────────────
select_video() {
    local choice
    choice=$(choose_one "Select video source" \
        "Paste file path" "Paste directory" "Browse with fzf" "Recent videos") \
        || die "Cancelled."
    case "$choice" in
        "Paste file path") input_file_path ;;
        "Paste directory") input_directory ;;
        "Browse with fzf") browse_fzf "$DEFAULT_SEARCH_DIR" ;;
        "Recent videos")   pick_recent ;;
        *) die "Unrecognised source choice: $choice" ;;
    esac
}

input_file_path() {
    local raw path
    raw=$(ask_text "Video path: " "~/Videos/gameplay.mp4") || die "Cancelled."
    [[ -z "$raw" ]] && die "No path entered."
    path=$(expand_path "$raw")
    [[ -f "$path" ]] || die "File not found: $path"
    is_video_file "$path" || die "Not a recognised video file: $path"
    printf '%s' "$path"
}

input_directory() {
    local raw dir
    raw=$(ask_text "Directory: " "~/Videos/clips/") || die "Cancelled."
    [[ -z "$raw" ]] && die "No path entered."
    dir=$(expand_path "$raw")
    [[ -d "$dir" ]] || die "Directory not found: $dir"
    browse_fzf "$dir"
}

browse_fzf() {
    local dir="${1:-$DEFAULT_SEARCH_DIR}"
    [[ -d "$dir" ]] || die "Directory not found: $dir"
    local list result
    list=$(build_find_cmd "$dir" || true)
    [[ -z "$list" ]] && die "No video files found under: $dir"
    result=$(printf '%s\n' "$list" | fzf --prompt "Select video > " --height 40% --border) \
        || die "No file selected."
    [[ -z "$result" ]] && die "No file selected."
    printf '%s' "$result"
}

pick_recent() {
    [[ -s "$HISTORY_FILE" ]] || die "No recent videos found."
    local result
    result=$(grep -v '^$' "$HISTORY_FILE" \
        | fzf --prompt "Recent > " --height 40% --border) || die "No file selected."
    [[ -z "$result" ]] && die "No file selected."
    [[ -f "$result" ]] || die "File no longer exists: $result"
    printf '%s' "$result"
}

# ─── Preset selection — sets globals directly ─────────────────────────────────
BUILTIN_PRESETS=(normal high_quality discord_480p discord_720p small_file)

do_select_preset() {
    local -A preset_map=()
    local -a ordered_labels=()

    local -A builtin_labels=(
        [normal]="Normal (720p, H264, crf22)"
        [high_quality]="High Quality (original res, crf18)"
        [discord_480p]="Discord 480p (<10MB, two-pass)"
        [discord_720p]="Discord 720p (<10MB, two-pass)"
        [small_file]="Small File (480p, crf28)"
    )

    local name label
    for name in "${BUILTIN_PRESETS[@]}"; do
        if [[ -f "$PRESETS_DIR/${name}.conf" ]]; then
            label="${builtin_labels[$name]}"
            ordered_labels+=("$label")
            preset_map["$label"]="$PRESETS_DIR/${name}.conf"
        fi
    done

    local pfile pname is_builtin b
    while IFS= read -r -d '' pfile; do
        pname=$(basename "$pfile" .conf)
        is_builtin=false
        for b in "${BUILTIN_PRESETS[@]}"; do
            [[ "$pname" == "$b" ]] && { is_builtin=true; break; }
        done
        if [[ "$is_builtin" == false ]]; then
            label="[custom] $pname"
            ordered_labels+=("$label")
            preset_map["$label"]="$pfile"
        fi
    done < <(find "$PRESETS_DIR" -maxdepth 1 -name "*.conf" -print0 2>/dev/null | sort -z)

    ordered_labels+=("Custom (manual settings)")

    local choice
    choice=$(choose_one "Encoding preset" "${ordered_labels[@]}") || die "Cancelled."

    if [[ "$choice" == "Custom (manual settings)" ]]; then
        PRESET_MODE="custom"
        return 0
    fi

    local sel="${preset_map[$choice]:-}"
    [[ -z "$sel" ]] && die "Could not map choice to a preset file: $choice"
    load_preset_file "$sel"
    PRESET_MODE="preset"
}

# ─── Label helpers ────────────────────────────────────────────────────────────
scale_label()   { [[ -z "$S_SCALE" ]] && echo "Original" || echo "${S_SCALE##*:}p"; }
fps_label()     { [[ -z "$S_FPS"   ]] && echo "Original" || echo "${S_FPS#fps=} FPS"; }
quality_label() {
    if [[ "$S_CODEC" == "copy" ]]; then echo "n/a (stream copy)"
    else echo "crf ${S_CRF}, ${S_PRESET_ENC}"; fi
}
codec_label() {
    case "$S_CODEC" in
        libx264) echo "H.264" ;; libx265) echo "H.265" ;;
        copy)    echo "Copy (no re-encode)" ;; *) echo "$S_CODEC" ;;
    esac
}
audio_label() {
    case "$S_AUDIO" in
        copy) echo "Copy original" ;; aac_192k) echo "AAC 192k" ;;
        aac_96k) echo "AAC 96k" ;;  mute) echo "Mute" ;; *) echo "$S_AUDIO" ;;
    esac
}
target_label() { [[ -z "$S_TARGET_SIZE" ]] && echo "None" || echo "${S_TARGET_SIZE}MB"; }

# ─── Setting menus ────────────────────────────────────────────────────────────
# Every menu ends in a *) branch: an unmatched selection warns loudly rather
# than silently leaving the setting unchanged.
menu_resolution() {
    local choice
    choice=$(choose_one "Resolution  [current: $(scale_label)]" \
        "Keep original" "1080p" "720p" "480p" "360p") || return 0
    case "$choice" in
        "Keep original") S_SCALE="" ;;
        "1080p")         S_SCALE="scale=-2:1080" ;;
        "720p")          S_SCALE="scale=-2:720" ;;
        "480p")          S_SCALE="scale=-2:480" ;;
        "360p")          S_SCALE="scale=-2:360" ;;
        *) warn "Unrecognised choice ($choice) — resolution unchanged." ;;
    esac
}

menu_fps() {
    local choice
    choice=$(choose_one "Frame rate  [current: $(fps_label)]" \
        "Keep original" "60 FPS" "30 FPS" "24 FPS") || return 0
    case "$choice" in
        "Keep original") S_FPS="" ;;
        "60 FPS")        S_FPS="fps=60" ;;
        "30 FPS")        S_FPS="fps=30" ;;
        "24 FPS")        S_FPS="fps=24" ;;
        *) warn "Unrecognised choice ($choice) — frame rate unchanged." ;;
    esac
}

menu_codec() {
    local choice
    choice=$(choose_one "Codec  [current: $(codec_label)]" \
        "H.264 (most compatible)" "H.265 (smaller files)" "Copy (fast, no re-encode)") || return 0
    case "$choice" in
        "H.264 (most compatible)")   S_CODEC="libx264" ;;
        "H.265 (smaller files)")     S_CODEC="libx265" ;;
        "Copy (fast, no re-encode)") S_CODEC="copy" ;;
        *) warn "Unrecognised choice ($choice) — codec unchanged." ;;
    esac

    if [[ "$S_CODEC" == "copy" && -n "$S_TARGET_SIZE" ]]; then
        warn "Stream copy cannot hit a target size — dropping the ${S_TARGET_SIZE}MB target."
        S_TARGET_SIZE=""
    fi
}

menu_quality() {
    local choice
    choice=$(choose_one "Quality  [current: $(quality_label)]" \
        "High (crf 18, slow)" "Balanced (crf 22, medium)" "Small (crf 26, fast)") || return 0
    case "$choice" in
        "High (crf 18, slow)")      S_CRF=18; S_PRESET_ENC=slow ;;
        "Balanced (crf 22, medium)") S_CRF=22; S_PRESET_ENC=medium ;;
        "Small (crf 26, fast)")     S_CRF=26; S_PRESET_ENC=fast ;;
        *) warn "Unrecognised choice ($choice) — quality unchanged." ;;
    esac
}

menu_audio() {
    local choice
    choice=$(choose_one "Audio  [current: $(audio_label)]" \
        "Copy original" "AAC 192k" "AAC 96k" "Mute (no audio)") || return 0
    case "$choice" in
        "Copy original")   S_AUDIO="copy" ;;
        "AAC 192k")        S_AUDIO="aac_192k" ;;
        "AAC 96k")         S_AUDIO="aac_96k" ;;
        "Mute (no audio)") S_AUDIO="mute" ;;
        *) warn "Unrecognised choice ($choice) — audio unchanged." ;;
    esac
}

# Crop dimensions are forced even: yuv420p needs even width/height, and ffmpeg
# silently rounds odd values, which quietly changes the aspect you asked for.
even_down() { local n="$1"; echo $(( n - (n % 2) )); }

menu_crop() {
    local choice
    choice=$(choose_one "Crop  [current: ${S_CROP:-None}]" \
        "No crop" "Center square" "Vertical 9:16" "Widescreen 16:9" "Custom crop") || return 0

    local W="$PROBE_WIDTH" H="$PROBE_HEIGHT"
    local cw ch cx cy
    case "$choice" in
        "No crop") S_CROP="" ;;
        "Center square")
            cw=$(even_down "$(( W < H ? W : H ))")
            cx=$(even_down "$(( (W - cw) / 2 ))"); cy=$(even_down "$(( (H - cw) / 2 ))")
            S_CROP="crop=${cw}:${cw}:${cx}:${cy}" ;;
        "Vertical 9:16")
            cw=$(even_down "$(( H * 9 / 16 ))")
            (( cw > W )) && cw=$(even_down "$W")
            ch=$(even_down "$H")
            cx=$(even_down "$(( (W - cw) / 2 ))")
            S_CROP="crop=${cw}:${ch}:${cx}:0" ;;
        "Widescreen 16:9")
            ch=$(even_down "$(( W * 9 / 16 ))")
            (( ch > H )) && ch=$(even_down "$H")
            cw=$(even_down "$W")
            cy=$(even_down "$(( (H - ch) / 2 ))")
            S_CROP="crop=${cw}:${ch}:0:${cy}" ;;
        "Custom crop")
            local w h x y
            w=$(ask_text "Width:  " "$W") || return 0
            h=$(ask_text "Height: " "$H") || return 0
            x=$(ask_text "X:      " "0") || return 0
            y=$(ask_text "Y:      " "0") || return 0
            [[ -z "$w" || -z "$h" || -z "$x" || -z "$y" ]] && { warn "All crop values required — crop unchanged."; return 0; }
            for v in "$w" "$h" "$x" "$y"; do
                [[ "$v" =~ ^[0-9]+$ ]] || { warn "Crop values must be whole numbers — crop unchanged."; return 0; }
            done
            (( w + x > W || h + y > H )) && { warn "Crop region falls outside ${W}x${H} — crop unchanged."; return 0; }
            S_CROP="crop=$(even_down "$w"):$(even_down "$h"):${x}:${y}" ;;
        *) warn "Unrecognised choice ($choice) — crop unchanged." ;;
    esac
}

menu_target_size() {
    local choice
    choice=$(choose_one "Target file size  [current: $(target_label)]" \
        "No target" "10 MB" "25 MB" "50 MB" "Custom") || return 0
    case "$choice" in
        "No target") S_TARGET_SIZE="" ;;
        "10 MB")     S_TARGET_SIZE="10" ;;
        "25 MB")     S_TARGET_SIZE="25" ;;
        "50 MB")     S_TARGET_SIZE="50" ;;
        "Custom")
            local raw
            raw=$(ask_text "Target size in MB: " "9.5") || return 0
            # Decimals are allowed: the shipped Discord presets use 9.5.
            if [[ "$raw" =~ ^[0-9]+(\.[0-9]+)?$ ]] \
               && awk -v v="$raw" 'BEGIN{exit !(v > 0)}'; then
                S_TARGET_SIZE="$raw"
            else
                warn "Invalid size — target unchanged."
            fi ;;
        *) warn "Unrecognised choice ($choice) — target unchanged." ;;
    esac

    if [[ -n "$S_TARGET_SIZE" && "$S_CODEC" == "copy" ]]; then
        warn "Stream copy cannot hit a target size — switching codec to H.264."
        S_CODEC="libx264"
    fi
}

offer_tweaks() {
    while true; do
        local choice
        choice=$(choose_one "Tweak preset settings?" \
            "No, looks good" \
            "Resolution  [$(scale_label)]" \
            "Frame rate  [$(fps_label)]" \
            "Codec       [$(codec_label)]" \
            "Quality     [$(quality_label)]" \
            "Audio       [$(audio_label)]" \
            "Crop        [${S_CROP:-None}]" \
            "Target size [$(target_label)]") || return 0

        case "$choice" in
            "No, looks good") return 0 ;;
            "Resolution"*)  menu_resolution ;;
            "Frame rate"*)  menu_fps ;;
            "Codec"*)       menu_codec ;;
            "Quality"*)     menu_quality ;;
            "Audio"*)       menu_audio ;;
            "Crop"*)        menu_crop ;;
            "Target size"*) menu_target_size ;;
            *) warn "Unrecognised choice ($choice)." ;;
        esac
    done
}

custom_menus() {
    menu_resolution; menu_fps; menu_codec
    [[ "$S_CODEC" != "copy" ]] && menu_quality
    menu_audio; menu_crop
}

# ─── Post options ─────────────────────────────────────────────────────────────
ask_post_options() {
    POST_SPEED=""
    POST_MUTE=false

    local speed_choice
    speed_choice=$(choose_one "Apply speed change?" \
        "No" "1.25x" "1.5x" "1.75x" "2x" "Custom") || return 0
    case "$speed_choice" in
        "No") ;;
        "Custom")
            local raw
            raw=$(ask_text "Speed multiplier (1.1–3.0): " "1.5") || return 0
            if [[ -n "$raw" ]] && awk -v v="$raw" 'BEGIN{exit !(v+0==v && v>=1.1 && v<=3.0)}' 2>/dev/null; then
                POST_SPEED="$raw"
            else
                warn "Invalid value — skipping speed change."
            fi ;;
        1.25x|1.5x|1.75x|2x) POST_SPEED="${speed_choice%x}" ;;
        *) warn "Unrecognised choice ($speed_choice) — no speed change." ;;
    esac

    local mute_choice
    mute_choice=$(choose_one "Mute audio in output?" "No" "Yes") || return 0
    [[ "$mute_choice" == "Yes" ]] && POST_MUTE=true
    return 0
}

# ─── Trim ─────────────────────────────────────────────────────────────────────
do_trim_with_mpv() {
    local file="$1"
    local marks_file="$RUN_TMP/marks"
    rm -f "$marks_file"

    if [[ ! -f "$MPV_LUA_SCRIPT" ]]; then
        warn "mpv helper script not found at $MPV_LUA_SCRIPT — using manual entry."
        do_trim_manual
        return
    fi

    info "Opening mpv — F1=start  F2=end  F3=save & quit"

    mpv --script="$MPV_LUA_SCRIPT" \
        --script-opts="trimtui-marks-file=$marks_file" \
        --osd-level=3 --osd-duration=2000 \
        "$file" >/dev/null 2>&1 || true

    # mpv takes over the terminal; restore stdin so gum works afterwards.
    [[ -e /dev/tty ]] && exec </dev/tty || true

    if [[ -f "$marks_file" ]]; then
        local s e
        s=$(grep -m1 "^START=" "$marks_file" 2>/dev/null | cut -d= -f2- || true)
        e=$(grep -m1 "^END="   "$marks_file" 2>/dev/null | cut -d= -f2- || true)
        if [[ -n "$s" && -n "$e" ]]; then
            if set_trim_points "$s" "$e"; then
                success "Marks: $TRIM_START → $TRIM_END"
                return 0
            fi
            warn "Marks were invalid (start must be before end)."
        fi
    fi
    warn "No usable marks set — falling back to manual input."
    do_trim_manual
}

# Validates and canonicalises a start/end pair into TRIM_START / TRIM_END.
set_trim_points() {
    local s_raw="$1" e_raw="$2"
    local s e s_secs e_secs
    s=$(normalize_ts "$s_raw") || return 1
    e=$(normalize_ts "$e_raw") || return 1
    s_secs=$(ts_to_secs "$s") || return 1
    e_secs=$(ts_to_secs "$e") || return 1
    (( e_secs > s_secs )) || return 1
    if (( PROBE_DURATION_SECS > 0 && s_secs >= PROBE_DURATION_SECS )); then
        return 1
    fi
    TRIM_START="$s"
    TRIM_END="$e"
    return 0
}

do_trim_manual() {
    [[ -e /dev/tty ]] && exec </dev/tty || true
    local s e
    while true; do
        s=$(ask_text "Start time (HH:MM:SS): " "00:02:15") || die "Cancelled."
        e=$(ask_text "End time   (HH:MM:SS): " "00:03:42") || die "Cancelled."
        if [[ -z "$s" || -z "$e" ]]; then
            warn "Both trim points are required."
            continue
        fi
        if set_trim_points "$s" "$e"; then
            return 0
        fi
        warn "Invalid range. Use SS, MM:SS or HH:MM:SS, and make sure end is after start."
    done
}

# ─── ffmpeg helpers ───────────────────────────────────────────────────────────
build_vf() {
    local filters=()
    [[ -n "$S_CROP"  ]] && filters+=("$S_CROP")
    [[ -n "$S_SCALE" ]] && filters+=("$S_SCALE")
    [[ -n "$S_FPS"   ]] && filters+=("$S_FPS")
    local IFS=","
    printf '%s' "${filters[*]}"
}

# atempo only accepts 0.5–2.0, so anything above 2x is chained.
build_af_speed() {
    local speed="$1"
    local s; s=$(awk -v v="$speed" 'BEGIN{printf "%.4f", v}')
    if awk -v s="$s" 'BEGIN{exit !(s > 2.0)}'; then
        local s2; s2=$(awk -v s="$s" 'BEGIN{printf "%.4f", s/2.0}')
        printf 'atempo=2.0,atempo=%s' "$s2"
    else
        printf 'atempo=%s' "$s"
    fi
}

# 3% is held back for container/muxing overhead so "under 10MB" really is.
calc_video_bitrate() {
    awk -v dur="$1" -v tmb="$2" -v abr="${3:-0}" '
    BEGIN {
        total = tmb * 8 * 1024 * 1024 * 0.97
        vbr = int((total - (abr * 1000 * dur)) / dur / 1000)
        print (vbr < 100 ? 100 : vbr)
    }'
}

audio_kbps_for() {
    case "$1" in
        aac_192k) printf '192' ;;
        aac_96k)  printf '96' ;;
        mute)     printf '0' ;;
        *)        printf '128' ;;
    esac
}

sanitize_tag() {
    printf '%s' "$1" | tr -d '()<> ' | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/_/g'
}

suggest_output() {
    local input="$1" tag="${2:-clip}"
    local name; name=$(basename "$input"); name="${name%.*}"
    printf '%s/%s_%s.mp4' "$TRIMTUI_OUTPUT_DIR" "$name" "$(sanitize_tag "$tag")"
}

run_ffmpeg() {
    local label="$1"; shift
    local errfile="$RUN_TMP/ffmpeg_err"
    if ! "$@" 2>"$errfile"; then
        printf '\n--- ffmpeg error (%s) ---\n' "$label" >&2
        tail -n 25 "$errfile" >&2
        printf -- '-------------------------\n' >&2
        return 1
    fi
    return 0
}

# ─── Summary ──────────────────────────────────────────────────────────────────
show_summary() {
    local input="$1" output="$2" vbr_info="${3:-}"
    local extra=""
    [[ -n "$POST_SPEED"     ]] && extra+="
$(gum style --bold "Speed:")       ${POST_SPEED}x"
    [[ "$POST_MUTE" == true ]] && extra+="
$(gum style --bold "Mute:")        yes"
    [[ -n "$vbr_info"       ]] && extra+="
$(gum style --bold "Bitrate:")     ~${vbr_info}kbps (two-pass, ${S_TARGET_SIZE}MB target)"

    gum style \
        --border rounded --border-foreground 10 --padding "0 2" --margin "1 0" \
        "$(gum style --bold "Input:")      $(basename "$input")
$(gum style --bold "Trim:")       $TRIM_START → $TRIM_END
$(gum style --bold "Resolution:") $(scale_label)
$(gum style --bold "FPS:")        $(fps_label)
$(gum style --bold "Codec:")      $(codec_label)
$(gum style --bold "Quality:")    $(quality_label)
$(gum style --bold "Audio:")      $(audio_label)
$(gum style --bold "Crop:")       ${S_CROP:-None}${extra}
$(gum style --bold "Output:")     $(basename "$output")" >&2
}

# ─── Encode ───────────────────────────────────────────────────────────────────
add_audio_args() {
    # Appends audio args to the named array. Honours "mute" in every path.
    local -n _arr="$1"
    if [[ "$PROBE_HAS_AUDIO" == false ]]; then
        _arr+=(-an)
        return
    fi
    case "$S_AUDIO" in
        copy)     _arr+=(-c:a copy) ;;
        aac_192k) _arr+=(-c:a aac -b:a 192k) ;;
        aac_96k)  _arr+=(-c:a aac -b:a 96k) ;;
        mute)     _arr+=(-an) ;;
        *)        _arr+=(-c:a copy) ;;
    esac
}

run_encode() {
    local input="$1" output="$2"
    mkdir -p "$(dirname "$output")"
    local vf; vf=$(build_vf)

    if [[ -n "$S_TARGET_SIZE" ]]; then
        if [[ "$S_CODEC" == "copy" ]]; then
            die "Cannot target a file size with stream copy. Pick H.264 or H.265."
        fi

        local s_secs e_secs clip_secs
        s_secs=$(ts_to_secs "$TRIM_START") || die "Bad start time."
        e_secs=$(ts_to_secs "$TRIM_END")   || die "Bad end time."
        clip_secs=$(( e_secs - s_secs ))
        (( clip_secs > 0 )) || die "End time must be after start time."

        local akbps; akbps=$(audio_kbps_for "$S_AUDIO")
        [[ "$PROBE_HAS_AUDIO" == false ]] && akbps=0

        local vbr
        vbr=$(calc_video_bitrate "$clip_secs" "$S_TARGET_SIZE" "$akbps")
        info "Two-pass — target ${S_TARGET_SIZE}MB, ~${vbr}kbps video"

        local passlog="$RUN_TMP/passlog"

        local p1=(ffmpeg -y -ss "$TRIM_START" -to "$TRIM_END" -i "$input")
        [[ -n "$vf" ]] && p1+=(-vf "$vf")
        p1+=(-c:v "$S_CODEC" -b:v "${vbr}k" -preset "$S_PRESET_ENC"
             -pass 1 -passlogfile "$passlog" -an -f null /dev/null)

        info "Pass 1/2..."
        run_ffmpeg "pass 1" "${p1[@]}" || die "Pass 1 failed."

        local p2=(ffmpeg -y -ss "$TRIM_START" -to "$TRIM_END" -i "$input")
        [[ -n "$vf" ]] && p2+=(-vf "$vf")
        p2+=(-c:v "$S_CODEC" -b:v "${vbr}k" -preset "$S_PRESET_ENC"
             -pass 2 -passlogfile "$passlog")
        if (( akbps > 0 )); then
            p2+=(-c:a aac -b:a "${akbps}k")
        else
            p2+=(-an)
        fi
        p2+=("$output")

        info "Pass 2/2..."
        run_ffmpeg "pass 2" "${p2[@]}" || die "Pass 2 failed."
    else
        local cmd=(ffmpeg -y -ss "$TRIM_START" -to "$TRIM_END" -i "$input")
        [[ -n "$vf" ]] && cmd+=(-vf "$vf")

        if [[ "$S_CODEC" == "copy" ]]; then
            if [[ -n "$vf" ]]; then
                die "Crop/scale/fps need a re-encode — stream copy can't apply filters."
            fi
            cmd+=(-c copy)
        else
            # The Discord presets carry crf=0 as an unused placeholder, since
            # two-pass drives bitrate instead. If the target gets dropped, that
            # 0 would silently mean "lossless" and produce a huge file.
            if [[ "$S_CRF" == "0" ]]; then
                warn "crf 0 is lossless and will make a very large file — using crf 22 instead."
                S_CRF=22
            fi
            cmd+=(-c:v "$S_CODEC" -crf "$S_CRF" -preset "$S_PRESET_ENC")
            add_audio_args cmd
        fi
        cmd+=("$output")

        info "Encoding..."
        run_ffmpeg "encode" "${cmd[@]}" || die "Encoding failed."
    fi

    [[ -s "$output" ]] || die "ffmpeg did not produce a usable output file."
    return 0
}

# ─── Post-processing (speed / mute) ──────────────────────────────────────────
apply_post() {
    local clip="$1"
    [[ -z "$POST_SPEED" && "$POST_MUTE" == false ]] && return 0

    local ext="${clip##*.}"
    local tmp="$RUN_TMP/post_out.${ext}"

    local has_audio
    has_audio=$(ffprobe -v error -select_streams a -show_entries stream=codec_type \
        -of csv=p=0 "$clip" 2>/dev/null | head -1 || true)

    if [[ -n "$POST_SPEED" ]]; then
        local vf_s
        vf_s="setpts=$(awk -v s="$POST_SPEED" 'BEGIN{printf "%.6f", 1/s}')*PTS"

        local cmd=(ffmpeg -y -i "$clip" -vf "$vf_s" -c:v libx264 -crf "$S_CRF" -preset "$S_PRESET_ENC")
        if [[ -n "$has_audio" && "$POST_MUTE" == false ]]; then
            cmd+=(-c:a aac -b:a 192k -af "$(build_af_speed "$POST_SPEED")")
        else
            cmd+=(-an)
        fi
        cmd+=("$tmp")

        info "Applying speed (${POST_SPEED}x)..."
        run_ffmpeg "speed" "${cmd[@]}" || die "Speed post-processing failed."
        [[ -s "$tmp" ]] || die "Speed pass produced no output."
        mv -f "$tmp" "$clip"
        success "Speed applied (${POST_SPEED}x)"
        return 0
    fi

    if [[ "$POST_MUTE" == true ]]; then
        if [[ -z "$has_audio" ]]; then
            info "Audio already absent — skipping mute step."
            return 0
        fi
        local cmd=(ffmpeg -y -i "$clip" -c:v copy -an "$tmp")
        info "Muting audio..."
        run_ffmpeg "mute" "${cmd[@]}" || die "Mute post-processing failed."
        [[ -s "$tmp" ]] || die "Mute pass produced no output."
        mv -f "$tmp" "$clip"
        success "Audio muted."
    fi
    return 0
}

# ─── Clipboard ────────────────────────────────────────────────────────────────
copy_to_clipboard() {
    local file="$1"
    local uri="file://$file"

    if [[ -n "${WAYLAND_DISPLAY:-}" ]] && have wl-copy; then
        if printf '%s\n' "$uri" | wl-copy --type text/uri-list 2>/dev/null; then
            success "Copied to clipboard (paste into a file manager, Discord, etc.)"
            return 0
        fi
    fi
    if [[ -n "${DISPLAY:-}" ]] && have xclip; then
        if printf '%s\n' "$uri" | xclip -selection clipboard -t text/uri-list 2>/dev/null; then
            success "Copied to clipboard."
            return 0
        fi
    fi
    if [[ -n "${DISPLAY:-}" ]] && have xsel; then
        if printf '%s\n' "$uri" | xsel --clipboard --input 2>/dev/null; then
            success "Copied to clipboard."
            return 0
        fi
    fi
    # Last resort: at least put the path somewhere useful.
    if have wl-copy && printf '%s' "$file" | wl-copy 2>/dev/null; then
        success "Copied file path to clipboard."
        return 0
    fi

    warn "No clipboard tool found (install wl-clipboard, xclip or xsel)."
    return 1
}

maybe_copy_to_clipboard() {
    local output="$1"
    local choice
    choice=$(choose_one "Copy the clip to your clipboard?" "No" "Yes") || return 0
    [[ "$choice" == "Yes" ]] && copy_to_clipboard "$output" || true
    return 0
}

# ─── Delete original ──────────────────────────────────────────────────────────
maybe_delete_original() {
    local original="$1"
    local fname; fname=$(basename "$original")

    local choice
    choice=$(choose_one "Delete original file? ($fname)" "No, keep it" "Yes, delete it") || return 0
    [[ "$choice" != "Yes, delete it" ]] && return 0

    choice=$(choose_one "Are you sure? This cannot be undone." "Cancel" "Yes, permanently delete") || return 0
    [[ "$choice" != "Yes, permanently delete" ]] && return 0

    rm -f "$original"
    success "Deleted: $original"
    return 0
}

# ─── Custom preset creator ────────────────────────────────────────────────────
create_custom_preset() {
    info "── Create custom preset ──"
    local pname
    pname=$(ask_text "Preset name: " "my_preset") || die "Cancelled."
    [[ -z "$pname" ]] && die "No name given."
    pname="${pname// /_}"
    pname=$(printf '%s' "$pname" | sed 's/[^A-Za-z0-9._-]/_/g')
    [[ -z "$pname" ]] && die "Preset name contained no usable characters."

    local b
    for b in "${BUILTIN_PRESETS[@]}"; do
        [[ "$pname" == "$b" ]] && die "'$pname' is a built-in preset name — pick another."
    done

    local dest="$PRESETS_DIR/${pname}.conf"
    if [[ -f "$dest" ]]; then
        local ow
        ow=$(choose_one "Preset '$pname' exists. Overwrite?" "No" "Yes") || die "Cancelled."
        [[ "$ow" != "Yes" ]] && die "Cancelled."
    fi

    menu_resolution; menu_fps; menu_codec
    [[ "$S_CODEC" != "copy" ]] && menu_quality
    menu_audio
    menu_target_size

    local res_val fps_val
    [[ -z "$S_SCALE" ]] && res_val="original" || res_val="${S_SCALE##*:}"
    [[ -z "$S_FPS"   ]] && fps_val="original" || fps_val="${S_FPS#fps=}"

    {
        printf '# Custom preset: %s\n' "$pname"
        printf 'resolution=%s\n' "$res_val"
        printf 'fps=%s\n' "$fps_val"
        printf 'codec=%s\n' "$S_CODEC"
        printf 'crf=%s\n' "$S_CRF"
        printf 'enc_preset=%s\n' "$S_PRESET_ENC"
        printf 'audio=%s\n' "$S_AUDIO"
        [[ -n "$S_TARGET_SIZE" ]] && printf 'target_size=%s\n' "$S_TARGET_SIZE"
    } > "$dest"

    success "Saved → $dest"
}

# ─── Flag parsing ─────────────────────────────────────────────────────────────
parse_flags() {
    while (($#)); do
        case "$1" in
            -d480) FLAG_PRESET="discord_480p"; FLAG_PRESET_TAG="discord"; shift ;;
            -d720) FLAG_PRESET="discord_720p"; FLAG_PRESET_TAG="discord"; shift ;;
            -n)    FLAG_PRESET="normal";       FLAG_PRESET_TAG="normal";  shift ;;
            -q)    FLAG_PRESET="high_quality"; FLAG_PRESET_TAG="quality"; shift ;;
            -s)    FLAG_PRESET="small_file";   FLAG_PRESET_TAG="small";   shift ;;
            -m)    FLAG_MUTE=true; shift ;;
            -x*)
                FLAG_SPEED="${1#-x}"
                [[ -z "$FLAG_SPEED" ]] && die "Usage: -x<speed>, e.g. -x1.5"
                awk -v v="$FLAG_SPEED" 'BEGIN{exit !(v+0==v && v>=1.1 && v<=3.0)}' 2>/dev/null \
                    || die "Invalid speed: $FLAG_SPEED (must be 1.1-3.0)"
                shift ;;
            -t)
                (($# >= 3)) || die "-t requires two timestamps: -t <start> <end>"
                FLAG_TS_START="$2"; FLAG_TS_END="$3"; shift 3 ;;
            -h|--help)    usage; exit 0 ;;
            -v|--version) printf '%s %s\n' "$APP_NAME" "$APP_VERSION"; exit 0 ;;
            --create-preset) POSITIONAL="--create-preset"; shift ;;
            --) shift; [[ $# -gt 0 ]] && { POSITIONAL="$1"; shift; } ;;
            -*) die "Unknown flag: $1 (see --help)" ;;
            *)  POSITIONAL="$1"; shift ;;
        esac
    done
}

usage() {
    cat <<EOF
$APP_NAME $APP_VERSION — terminal video cutter/converter

Usage:
  $APP_NAME                  Interactive: pick a video, preset, trim, encode
  $APP_NAME <file>           Start with a specific video file
  $APP_NAME <directory>      Browse that directory with fzf
  $APP_NAME --create-preset  Create a reusable custom preset
  $APP_NAME --version        Print version
  $APP_NAME --help           Show this help

Flag mode (skips every menu except crop and trim marking):
  -d480          Discord 480p preset (<10MB, two-pass)
  -d720          Discord 720p preset (<10MB, two-pass)
  -n             Normal preset (720p, H264, crf22)
  -q             High Quality preset (original res, crf18)
  -s             Small File preset (480p, crf28)
  -m             Mute the output audio
  -x<speed>      Apply a speed change, e.g. -x1.5, -x2
  -t <start> <end>   Trim points, e.g. -t 1:30 2:45 (skips mpv)

  No file given -> opens the interactive video picker first.
  No -t given   -> opens mpv for F1/F2 marking.
  Output is named <clip>_<preset>.mp4, e.g. clip_discord.mp4

  Examples:
    $APP_NAME -d720 clip.mp4
    $APP_NAME -d480 -m -t 1:30 2:45 clip.mp4
    $APP_NAME -n -x1.5

Config:  $TRIMTUI_CONFIG/config
Presets: $PRESETS_DIR
Output:  $TRIMTUI_OUTPUT_DIR
EOF
}

# ─── Main ─────────────────────────────────────────────────────────────────────
main() {
    parse_flags "$@"

    check_deps
    have gum || { printf 'trimtui: missing required dependency: gum\n' >&2; exit 1; }

    mkdir -p "$TRIMTUI_CONFIG/mpv" "$PRESETS_DIR" "$TRIMTUI_OUTPUT_DIR"
    touch "$HISTORY_FILE"
    RUN_TMP=$(mktemp -d "${TMPDIR:-/tmp}/trimtui.XXXXXXXX")

    gum style \
        --border double --border-foreground 12 \
        --align center --padding "0 4" --margin "1 0" \
        "$(gum style --bold --foreground 12 "trim")$(gum style --bold "tui")" >&2

    if [[ "$POSITIONAL" == "--create-preset" ]]; then
        load_config
        create_custom_preset
        exit 0
    fi

    load_config

    # ── 1. Select video ──
    local video_file
    if [[ -n "$POSITIONAL" ]]; then
        local arg; arg=$(expand_path "$POSITIONAL")
        if   [[ -d "$arg" ]]; then video_file=$(browse_fzf "$arg")
        elif [[ -f "$arg" ]]; then
            is_video_file "$arg" || die "Not a recognised video file: $arg"
            video_file="$arg"
        else die "Path not found: $arg"; fi
    else
        video_file=$(select_video)
    fi
    [[ -n "$video_file" && -f "$video_file" ]] || die "No video selected."

    probe_video "$video_file"
    add_to_history "$video_file"
    show_video_info "$video_file"

    # ── FLAG MODE: preset + post-options already known, skip every menu ──
    if [[ -n "$FLAG_PRESET" ]]; then
        load_preset_file "$PRESETS_DIR/${FLAG_PRESET}.conf"
        PRESET_MODE="preset"
        POST_SPEED="$FLAG_SPEED"
        POST_MUTE="$FLAG_MUTE"

        if [[ -n "$FLAG_TS_START" && -n "$FLAG_TS_END" ]]; then
            set_trim_points "$FLAG_TS_START" "$FLAG_TS_END" \
                || die "Invalid trim range: $FLAG_TS_START -> $FLAG_TS_END (check order and format)"
        else
            do_trim_with_mpv "$video_file"
        fi
        [[ -n "$TRIM_START" && -n "$TRIM_END" ]] || die "No trim points saved."

        local output_path; output_path=$(suggest_output "$video_file" "$FLAG_PRESET_TAG")
        if [[ -e "$output_path" ]]; then
            local ow
            ow=$(choose_one "Output exists. Overwrite? ($(basename "$output_path"))" "No" "Yes") \
                || die "Cancelled."
            [[ "$ow" != "Yes" ]] && die "Cancelled — output file left alone."
        fi

        info "Encoding → $(basename "$output_path")"
        run_encode "$video_file" "$output_path"
        apply_post "$output_path"
        [[ -s "$output_path" ]] || die "Output file missing after encode."

        local final_size; final_size=$(du -h "$output_path" 2>/dev/null | cut -f1 || echo "?")
        success "Saved → $output_path ($final_size)"

        maybe_delete_original "$video_file"
        maybe_copy_to_clipboard "$output_path"
        exit 0
    fi

    # ── 2. Preset (interactive) ──
    do_select_preset
    if [[ "$PRESET_MODE" == "custom" ]]; then
        custom_menus
    else
        gum style --foreground 12 \
"Preset loaded:
  Resolution: $(scale_label)   FPS: $(fps_label)
  Codec: $(codec_label)   Quality: $(quality_label)
  Audio: $(audio_label)   Target: $(target_label)" >&2
        offer_tweaks
    fi

    # ── 3. Trim method ──
    local trim_method
    trim_method=$(choose_one "Trim method" \
        "Use F1/F2 keys in mpv" "Type timestamps manually") || die "Cancelled."

    # ── 4. Post options ──
    ask_post_options

    # ── 5. Output path ──
    local suggested; suggested=$(suggest_output "$video_file" "$PRESET_MODE")
    local output_path
    output_path=$(ask_text "Output file: " "" "$suggested") || die "Cancelled."
    [[ -z "$output_path" ]] && die "No output path given."
    output_path=$(expand_path "$output_path")
    [[ "$output_path" == */ ]] && die "Output must be a file, not a directory."

    if [[ -e "$output_path" ]]; then
        local ow
        ow=$(choose_one "Output exists. Overwrite? ($(basename "$output_path"))" "No" "Yes") \
            || die "Cancelled."
        [[ "$ow" != "Yes" ]] && die "Cancelled — output file left alone."
    fi

    # ── 6. Trim points ──
    case "$trim_method" in
        "Use F1/F2 keys in mpv")     do_trim_with_mpv "$video_file" ;;
        "Type timestamps manually")  do_trim_manual ;;
        *) die "Unrecognised trim method: $trim_method" ;;
    esac
    [[ -n "$TRIM_START" && -n "$TRIM_END" ]] || die "No trim points saved."

    # ── 7. Summary ──
    local vbr_preview=""
    if [[ -n "$S_TARGET_SIZE" ]]; then
        local s_secs e_secs c_secs akbps
        s_secs=$(ts_to_secs "$TRIM_START")
        e_secs=$(ts_to_secs "$TRIM_END")
        c_secs=$(( e_secs - s_secs ))
        akbps=$(audio_kbps_for "$S_AUDIO")
        [[ "$PROBE_HAS_AUDIO" == false ]] && akbps=0
        vbr_preview=$(calc_video_bitrate "$c_secs" "$S_TARGET_SIZE" "$akbps")
    fi
    show_summary "$video_file" "$output_path" "$vbr_preview"

    # ── 8. Confirm ──
    local go
    go=$(choose_one "Start conversion?" "Yes, encode now" "Cancel") || { info "Cancelled."; exit 0; }
    [[ "$go" != "Yes, encode now" ]] && { info "Cancelled."; exit 0; }

    # ── 9. Encode ──
    run_encode "$video_file" "$output_path"

    # ── 10. Post-processing ──
    apply_post "$output_path"

    # ── 11. Done ──
    [[ -s "$output_path" ]] || die "Output file missing after encode."
    local final_size
    final_size=$(du -h "$output_path" 2>/dev/null | cut -f1 || echo "?")
    success "Saved → $output_path ($final_size)"

    # ── 12. Delete original? ──
    maybe_delete_original "$video_file"

    # ── 13. Copy to clipboard? ──
    maybe_copy_to_clipboard "$output_path"
}

main "$@"
